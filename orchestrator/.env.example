# --- AgentPhone (host, mandatory) ---
AGENTPHONE_API_KEY=ap_REPLACE_ME
AGENTPHONE_BASE_URL=https://api.agentphone.ai/v1
# After provisioning each agent, store its webhook secret in agents.json (per-agent).

# --- Public tunnel URL for AgentPhone webhooks ---
PUBLIC_BASE_URL=https://CHANGE_ME.ngrok.app

# --- Lambda PAVO server (proprietary routing + completion) ---
PAVO_BASE_URL=http://129.146.122.8:8000/v1
PAVO_API_KEY=local-shared-secret

# --- Cloud LLM (fallback if PAVO server unreachable) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=

# --- Sponsor credits ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_TEST_MODE=true
AGENTMAIL_API_KEY=REPLACE_ME
BROWSERUSE_API_KEY=REPLACE_ME
SPONGE_API_KEY=
SUPERMEMORY_API_KEY=
# Moss takes two credentials (project_id + project_key), not one API key.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=move-runbooks

# Gemini (Google DeepMind sponsor) — generate at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- AgentPhone parallel-call cap (set after T9 pre-flight) ---
AGENTPHONE_PARALLEL_CAP=6

# Synthetic mode — runs fake 4-turn conversations via PAVO instead of real
# AgentPhone calls. Useful for rehearsal + backup demo video. Set false for
# the real demo on stage; set true to record the backup video.
SYNTHETIC_MODE=false

# --- App ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Demo target phone (your cellphone for the 'real call to judge' moment in dev)
DEMO_HOMEOWNER_NUMBER=+14155550100
# Where the AgentMail receipt PDF gets sent during the demo (use a real inbox you can check)
DEMO_EMAIL_RECIPIENT=vnarasingamoorthy@gmail.com
