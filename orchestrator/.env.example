# Relocate local-development configuration.
#
# Copy to orchestrator/.env, replace every REPLACE_* value, and never commit the
# resulting file. Generate tokens with:  openssl rand -hex 32

# --- Application security ---
APP_ENV=development
ENABLE_DEV_TRIGGER=false
# Only required when ENABLE_DEV_TRIGGER=true.
ADMIN_API_TOKEN=
DASHBOARD_API_TOKEN=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Public web intake (POST /api/public/start-move) for the website's "Start your
# move" form, and the redacted per-move snapshot (GET /api/public/move/{id})
# behind the /move tracker page. Off by default. A supervised demo deployment
# sets this true and adds the website origin (e.g. https://vnmoorthy.github.io)
# to CORS_ALLOWED_ORIGINS; the unauthenticated /ws/public feed is redacted
# server-side and is always on.
ENABLE_PUBLIC_INTAKE=false

# Never embed DASHBOARD_API_TOKEN in NEXT_PUBLIC_WS_URL or any client build.
# For a local live view, run.sh prints http://127.0.0.1:3000/#ws-token=<token>;
# the page keeps the token in sessionStorage and sends it in the WebSocket
# subprotocol offer, never in a query string. The public Pages workflow still
# builds a demo-only static dashboard. A live product needs a short-lived,
# user- and move-scoped WebSocket ticket.

# --- AgentPhone inbound voice ---
# The app can boot with this blank for dashboard-only development, but inbound
# voice will not work until a real key and provisioned agents.json exist.
AGENTPHONE_API_KEY=
AGENTPHONE_BASE_URL=https://api.agentphone.ai/v1
PUBLIC_BASE_URL=http://127.0.0.1:8000
AGENTPHONE_PARALLEL_CAP=6

# --- PAVO routing/completion service ---
# Local run.sh uses the loopback URL below. Remote deployments must use HTTPS or
# private networking; never send transcripts to a public plain-HTTP endpoint.
PAVO_BASE_URL=http://127.0.0.1:8765/v1
PAVO_API_KEY=REPLACE_WITH_ANOTHER_64_HEX_TOKEN

# Local OpenAI-compatible model endpoint used by the PAVO process.
VLLM_URL=http://127.0.0.1:11434/v1/chat/completions
VLLM_MODEL=gemma2:2b

# Optional PAVO cloud tiers. These are loaded by local run.sh into the PAVO
# process. Keep them in a secret manager in hosted environments.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-1
OPENAI_API_KEY=

# --- Specialist providers ---
# Blank keys disable the provider. Normal tests replace every provider boundary
# with a mock and never read these values.
# AgentMail also carries the two batch sends: the playbook digest for blocked
# specialists, and the arrival pack that collects every prepared specialist's
# section into one email to the customer.
AGENTMAIL_API_KEY=
# Fail-safe outbound-email policy: every AgentMail recipient (institutional
# intake addresses AND the customer's own email) must be listed here,
# comma-separated. Empty blocks ALL outbound email, even with a key configured.
AGENTMAIL_ALLOWED_RECIPIENTS=
# Demo routing: when set, EVERY outbound email is rerouted to this single
# operator-controlled address, with subject+body labeled with the true
# intended recipient. The address must itself be allowlisted above. This is
# how a demo deployment produces real email artifacts without ever contacting
# a real institution. Leave empty for normal (allowlist-only) routing.
AGENTMAIL_DEMO_RECIPIENT_OVERRIDE=
BROWSERUSE_API_KEY=
LOB_API_KEY=
SUPERMEMORY_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=move-runbooks
SPONGE_API_KEY=

# Stripe is a demo-only PaymentIntent adapter. Keep test mode enabled; the
# provider acceptance suite rejects live keys.
STRIPE_SECRET_KEY=
STRIPE_TEST_MODE=true

# --- Runtime ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Public website root — used to build the /move/#<id> tracker links in the
# post-call follow-up and web-dispatch emails.
PUBLIC_SITE_URL=https://vnmoorthy.github.io/relocate-ai
DEMO_HOMEOWNER_NUMBER=+14155550100
DEMO_EMAIL_RECIPIENT=demo.mover@example.com

# Durable single-node state (SQLite). Events, buyer contexts, and webhook
# dedupe records survive restarts; in-flight specialists recover as honest
# needs-user-action. Empty disables persistence (the test suite does this).
DATABASE_PATH=data/relocate.db

# Signs public event aliases and demo-workspace session tokens. Set a fixed
# random value in any deployment you demo from: blank falls back to a
# per-process key, so every restart rotates aliases and signs sessions out.
PUBLIC_REF_SECRET=

# Gated product surface (/app): ONE shared workspace credential, verified
# server-side by POST /api/public/demo-login, which returns a signed expiring
# token — the password never reaches the static bundle. Blank DEMO_PASSWORD
# disables the login and GET /api/public/demo/moves entirely (503), which is
# the default. The workspace lists only moves started through it
# (origin_channel="demo"), so publishing these credentials cannot expose a
# real caller's move. This is a shared demo workspace, not per-user auth: set
# PUBLIC_REF_SECRET above so sessions survive a restart, rotate the password
# like any other credential, and never run a real customer's move through it.
DEMO_USERNAME=demo
DEMO_PASSWORD=
# Session lifetime for a /app sign-in, in hours (default 12).
DEMO_SESSION_HOURS=12

# Twilio as a second telephony rail (alternative to AgentPhone).
# Point a Twilio number's Voice webhook at POST /webhook/twilio/voice
# and its status callback at POST /webhook/twilio/status, then set the
# account's auth token here. Blank disables the rail entirely.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# E.164, e.g. +15125551234. With all three set, demo-line.sh re-points the
# number's voice webhook automatically whenever the tunnel rotates.
TWILIO_PHONE_NUMBER=

# Supabase mirror (optional). SQLite stays the source of truth; when both
# are set, every move is written through to Postgres as well. The service
# key bypasses row-level security — server-side only, never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
